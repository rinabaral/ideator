
<% if @idea.present? %>
  <%= link_to 'Inspire Me', random_path, class: 'btn btn-primary btn-block',style: 'width: 100px; margin: 0 auto;' %>
    
  <div class="panel panel-default">
    <div class="panel-body">
      <blockquote>
        <p><%= @idea.description %></p>
        <small>by <%= @idea.author %></small>
      </blockquote>
        
      <br>

      <div class="btn-group" role="group">
        <%= link_to idea_path(@idea), method: :delete, class: 'btn btn-sm btn-danger', data: {confirm: "Are you sure?"} do %>
        <i class="fa fa-trash"></i>
        <% end %>
        <%= link_to edit_idea_path(@idea), class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-pencil-square"></i>
        <% end %>
      </div>
    </div>
  </div>
 <% end %>