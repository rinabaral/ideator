<center><button type="button" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#myModal" style="margin:0 auto">
  Add an ideas
</button></center></br>
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">

  <div class="modal-dialog" role="document">

    <div class="modal-content">

      <div class="modal-header">

        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>

        <h4 class="modal-title" id="myModalLabel">Idea description</h4>

      </div>

      <div class="modal-body">

      <%= simple_form_for Idea.new do |f| %>
  <%= f.input :description %>
  <%= f.input :author %>
  <%= f.submit 'Submit', class: 'btn btn-primary'%>
<% end %>

      </div>

    </div>

  </div>

</div>

<% @ideas.each do |idea| %>
  <div class="panel panel-default">
    <div class="panel-body">
      <blockquote>
        <p><%= idea.description %></p>
        <small>by <%= idea.author %></small>
      </blockquote> <br><%= link_to idea_path(idea), method: :delete,class: 'btn btn-sm btn-danger', data: {confirm: "Are you sure?"} do %>
      <i class="fa fa-trash"></i>
      <% end %>
      <%= link_to edit_idea_path(idea), class: 'btn btn-sm btn-success' do %>
      <i class="fa fa-pencil-square"></i>
      <% end %>
    </div>
  </div>
<% end %>

<div class = "text-center">
  <%= will_paginate @ideas %>
</div>
